[diff]
  pager = "delta"

[data]
  opsTools = {{ promptBool "Install Ops tools (kubectl + k9s, minikube, terraform, ansible...)" }}
  {{- if eq .chezmoi.os "darwin" }}
  preferSecretive = {{ promptBool "Prefer Secretive over 1Password for SSH-agent? (If you don't know what this means, say no.)" }}
  {{- else }}
  preferSecretive = false
  {{- end }}
  
[hooks.read-source-state.pre]
    command = ".local/share/chezmoi/.install-pre-init.sh"