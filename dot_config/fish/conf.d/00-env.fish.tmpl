# Core tools
set -gx EDITOR "zed --wait"
set -gx PAGER bat
set -gx MANPAGER "sh -c 'col -bx | bat -l man -p'"

set -gx HOMEBREW_NO_ENV_HINTS 1
set -gx SHELL_SESSIONS_DISABLE 1

# XDG dirs
set -gx XDG_CONFIG_HOME "$HOME/.config"
set -gx XDG_CACHE_HOME "$HOME/.cache"
set -gx XDG_DATA_HOME "$HOME/.local/share"
set -gx XDG_STATE_HOME "$HOME/.local/state"
set -gx XDG_BIN_HOME "$HOME/.local/bin"
set -gx XDG_RUNTIME_DIR "$HOME/.local/run"

# Paths to keep $HOME clean
set -gx GOPATH "$XDG_DATA_HOME/go"
set -gx GOBIN "$XDG_BIN_HOME"
set -gx CARGO_HOME "$XDG_DATA_HOME/cargo"
set -gx DOCKER_CONFIG "$XDG_CONFIG_HOME/docker"
set -gx NPM_CONFIG_INIT_MODULE "$XDG_CONFIG_HOME/npm/config/npm-init.js"
set -gx NPM_CONFIG_CACHE "$XDG_CACHE_HOME/npm"
# set -gx GNUPGHOME "$XDG_DATA_HOME/gnupg" -- check gpgconf --list-dirs to see what sockets reference this
{{ if .cloudInstall }}
set -gx ANSIBLE_HOME "$XDG_DATA_HOME/ansible"
set -gx AWS_SHARED_CREDENTIALS_FILE "$XDG_CONFIG_HOME/aws/credentials"
set -gx AWS_CONFIG_FILE "$XDG_CONFIG_HOME/aws/config"
set -gx MINIKUBE_HOME "$XDG_DATA_HOME/minikube"
{{ end }}

# UI & color
set -gx CLICOLOR 1
set -gx LS_COLORS 'di=1;34:ln=1;35:so=1;32:pi=1;33:ex=1;31:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43'

# Homebrew prefix (modern macOS assumption)
set -gx HOMEBREW_PREFIX /opt/homebrew
if test -x "$HOMEBREW_PREFIX/bin/brew"
    $HOMEBREW_PREFIX/bin/brew shellenv fish | source
end

# PATH construction (exact priority order, de-duplicated)
fish_add_path --move --path \
    "$HOMEBREW_PREFIX/bin" \
    "$HOMEBREW_PREFIX/sbin" \
    /usr/local/bin \
    /usr/bin \
    /bin \
    /usr/sbin \
    /sbin

test -d "$HOME/.lmstudio/bin"; and fish_add_path --append --path "$HOME/.lmstudio/bin"
test -d "$HOME/.local/bin"; and fish_add_path --append --path "$HOME/.local/bin"
test -d "$HOME/.bun/bin"; and fish_add_path --append --path "$HOME/.bun/bin"
